# GEMINI_API_KEY: Required for optional AI summarization/provider calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Local path for the persistent SQLite + FTS5 archive database.
SQLITE_DB_PATH="data/database/telegram_archive.db"

# TELEGRAM COLLECTOR (Local-Only — NEVER uploaded to any cloud provider)
TG_API_ID="123456"
TG_API_HASH="your_local_telegram_api_hash"
TG_SESSION_PATH="data/telegram_session"
CLOUD_SYNC_ENDPOINT=""
